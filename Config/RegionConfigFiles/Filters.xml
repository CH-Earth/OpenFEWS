	<!-- First Level Filters -->
	<filter id="webservices" name="webservices">
		<child foreignKey="HindcastData"/>
	</filter>
	<filter id="HindcastData" name="Hindcast Data">
		<child foreignKey="HindcastHydroStations"/>
		<child foreignKey="HindcastMeteoStations"/>
		<child foreignKey="ForecastDataStations"/>
		<child foreignKey="ForecastDataBasins"/>
	</filter>
	<filter id="ForecastDataStations" name="Forecast Data - By Station">
		<mapExtentId>$REGION$</mapExtentId>
		<child foreignKey="HRDPAStations"/>
		<child foreignKey="RDPAStations"/>
		<child foreignKey="RDPSStations"/>
		<child foreignKey="GDPSStations"/>
		<child foreignKey="REPSStations"/>
		<child foreignKey="GEPSStations"/>
		<child foreignKey="GEFSStations"/>
		<child foreignKey="IFSStations"/>
	</filter>
	<filter id="ForecastDataBasins" name="Forecast Data - By Basin">
		<mapExtentId>$REGION$</mapExtentId>
		<child foreignKey="HRDPABasins"/>
		<child foreignKey="RDPABasins"/>
		<child foreignKey="RDPSBasins"/>
		<child foreignKey="GDPSBasins"/>
		<child foreignKey="REPSBasins"/>
		<child foreignKey="GEPSBasins"/>
		<child foreignKey="GEFSBasins"/>
		<child foreignKey="IFSBasins"/>
	</filter>
