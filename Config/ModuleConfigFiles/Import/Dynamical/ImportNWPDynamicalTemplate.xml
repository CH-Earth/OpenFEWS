<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews
http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
	<import>
		<general>
			<importType>NETCDF-CF_GRID</importType>
			<folder>$IMPORT_FOLDER$/$MODEL$</folder>
			<idMapId>Id$MODULE_INSTANCE_ID$</idMapId>
			<unitConversionsId>$UNITCONVERSION$</unitConversionsId>
			<importTimeZone>
				<timeZoneName>GMT+0</timeZoneName>
			</importTimeZone>
			<dataFeedId>$MODEL$</dataFeedId>
		</general>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>PR.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>TA.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>XS.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
			<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>PA.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>RS.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>RL.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>US.nwp</parameterId>
			<locationId>$INPUTGRID$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<externUnit parameterId="PC.nwp" unit="kg m-2"/>
		<externUnit parameterId="PR.nwp" unit="mm/s"/>
		<externUnit parameterId="TA.nwp" unit="degC"/>
		<externUnit parameterId="XS.nwp" unit="kg/kg"/>
		<externUnit parameterId="PA.nwp" unit="Pa"/>
		<externUnit parameterId="RS.nwp" unit="J/m2"/>
		<externUnit parameterId="RL.nwp" unit="J/m2"/>
		<externUnit parameterId="US.nwp" unit="m/s"/>
		<interpolateSerie parameterId="PC.nwp" interpolate="true"/>
		<interpolateSerie parameterId="PR.nwp" interpolate="true"/>
		<interpolateSerie parameterId="TA.nwp" interpolate="true"/>
		<interpolateSerie parameterId="XS.nwp" interpolate="true"/>
		<interpolateSerie parameterId="PA.nwp" interpolate="true"/>
		<interpolateSerie parameterId="RS.nwp" interpolate="true"/>
		<interpolateSerie parameterId="RL.nwp" interpolate="true"/>
		<interpolateSerie parameterId="US.nwp" interpolate="true"/>
	</import>
</timeSeriesImportRun>
