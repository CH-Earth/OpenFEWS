<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
	<import>
		<general>
			<importType>NETCDF-CF_GRID</importType>
			<folder>$IMPORT_FOLDER$/ECMWF</folder>
			<fileNameForecastCreationDateTimePattern>yyyyMMddHHmmss'_???H.nc'</fileNameForecastCreationDateTimePattern>
			<idMapId>IdImportECMWF</idMapId>
			<unitConversionsId>ImportECMWFUnits</unitConversionsId>
			<importTimeZone>
				<timeZoneName>GMT+0</timeZoneName>
			</importTimeZone>
			<dataFeedId>IFS</dataFeedId>
		</general>
		<timeSeriesSet>
			<moduleInstanceId>ImportIFSDet</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>PC.nwp</parameterId>
			<locationId>IFS</locationId>
			<timeSeriesType>external forecasting</timeSeriesType>
			<timeStep unit="hour" multiplier="3"/>
			<readWriteMode>add originals</readWriteMode>
		</timeSeriesSet>
		<timeSeriesSet>
			<moduleInstanceId>ImportIFSDet</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>TA.nwp</parameterId>
			<locationId>IFS</locationId>
			<timeSeriesType>external forecasting</timeSeriesType>
			<timeStep unit="hour" multiplier="3"/>
			<readWriteMode>add originals</readWriteMode>
		</timeSeriesSet>
		<externUnit parameterId="PC.nwp" unit="m"/>
		<externUnit parameterId="TA.nwp" unit="K"/>
		<interpolateSerie parameterId="PC.nwp" interpolate="true"/>
		<interpolateSerie parameterId="TA.nwp" interpolate="true"/>
	</import>
</timeSeriesImportRun>
