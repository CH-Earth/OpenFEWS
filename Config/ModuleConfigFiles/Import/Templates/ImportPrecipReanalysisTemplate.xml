<?xml version="1.0" encoding="UTF-8"?>
<timeSeriesImportRun xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/timeSeriesImportRun.xsd">
	<import>
		<general>
			<importType>$IMPORTTYPE$</importType>
			<folder>$IMPORT_FOLDER$/$MODEL$</folder>
			<idMapId>IdImport$MODEL$</idMapId>
			<unitConversionsId>ImportUnitConversions</unitConversionsId>
			<importTimeZone>
				<timeZoneName>MST</timeZoneName>
			</importTimeZone>
			<dataFeedId>$MODEL$</dataFeedId>
		</general>
		<timeSeriesSet>
			<moduleInstanceId>Import$MODEL$</moduleInstanceId>
			<valueType>grid</valueType>
			<parameterId>$PARAMETER$</parameterId>
			<locationId>$MODEL$</locationId>
			<timeSeriesType>$GRIDTIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="$TIMESTEP_HOUR$"/>
			<readWriteMode>add originals</readWriteMode>
			<ensembleId>$ENSEMBLE$</ensembleId>
		</timeSeriesSet>
		<externUnit parameterId="$PARAMETER$" unit="$PARAMETER_UNIT$"/>
	</import>
</timeSeriesImportRun>
