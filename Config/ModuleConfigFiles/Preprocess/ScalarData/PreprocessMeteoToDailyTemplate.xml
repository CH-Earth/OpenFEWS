<transformationModule xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/transformationModule.xsd" version="1.0">
	<!---->
	<!--Input-->
	<variable>
		<variableId>PC_hourly</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PC.sim</parameterId>
			<locationSetId>$LOCATIONSET$</locationSetId>
			<timeSeriesType>$TIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>TA_hourly</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TA.sim</parameterId>
			<locationSetId>$LOCATIONSET$</locationSetId>
			<timeSeriesType>$TIMESERIESTYPE$</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>PC_day</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PC.sim</parameterId>
			<locationSetId>$LOCATIONSET$</locationSetId>
			<timeSeriesType>$TIMESERIESTYPE$</timeSeriesType>
			<timeStep id="$TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>TA_day</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TA.sim</parameterId>
			<locationSetId>$LOCATIONSET$</locationSetId>
			<timeSeriesType>$TIMESERIESTYPE$</timeSeriesType>
			<timeStep id="$TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<!--Output-->
	<!--Transformations-->
	<transformation id="PC_Daily_sum">
		<aggregation>
			<accumulative>
				<inputVariable>
					<variableId>PC_hourly</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>PC_day</variableId>
				</outputVariable>
			</accumulative>
		</aggregation>
	</transformation>
	<transformation id="TA_Daily_Mean">
		<statisticsSerial>
			<mean>
				<inputVariable>
					<variableId>TA_hourly</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>TA_day</variableId>
				</outputVariable>
			</mean>
		</statisticsSerial>
	</transformation>
</transformationModule>