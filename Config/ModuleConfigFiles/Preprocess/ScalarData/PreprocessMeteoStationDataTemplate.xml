<transformationModule xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/transformationModule.xsd" version="1.0">
	<!--Input-->
	<variable>
		<variableId>station_precip_hourly</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$INPUT_MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PC.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>station_temp_hourly</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$INPUT_MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TA.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<!--Output Station-->
	<variable>
		<variableId>station_precip_filled</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$INPUT_MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PC.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>temporary</timeSeriesType>
			<timeStep unit="hour" multiplier="1"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>station_precip</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PC.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>station_temp_ave</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TA.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>station_temp_max</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TAmax.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>station_temp_min</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TAmin.obs</parameterId>
			<locationSetId>$STATIONLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<!-- Output Basin-->
	<variable>
		<variableId>basin_precip</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>PC.obs</parameterId>
			<locationSetId>$BASINLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>basin_temp_ave</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TA.obs</parameterId>
			<locationSetId>$BASINLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>basin_temp_max</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TAmax.obs</parameterId>
			<locationSetId>$BASINLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<variable>
		<variableId>basin_temp_min</variableId>
		<timeSeriesSet>
			<moduleInstanceId>$MODULE_INSTANCE_ID$</moduleInstanceId>
			<valueType>scalar</valueType>
			<parameterId>TAmin.obs</parameterId>
			<locationSetId>$BASINLOCATIONS$</locationSetId>
			<timeSeriesType>external historical</timeSeriesType>
			<timeStep id="$DAY_TIMESTEP$"/>
			<readWriteMode>read complete forecast</readWriteMode>
		</timeSeriesSet>
	</variable>
	<!--Transformations-->
	<transformation id="station_precip_fill">
		<merge>
			<simple>
				<inputVariable>
					<variableId>station_precip_hourly</variableId>
				</inputVariable>
				<fillGapConstant>0</fillGapConstant>
				<outputVariable>
					<variableId>station_precip_filled</variableId>
				</outputVariable>
			</simple>
		</merge>
	</transformation>
	<transformation id="station_precip_to_daily">
		<aggregation>
			<accumulative>
				<inputVariable>
					<variableId>station_precip_filled</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>station_precip</variableId>
				</outputVariable>
			</accumulative>
		</aggregation>
	</transformation>
	<transformation id="basin_precip">
		<interpolationSpatial>
			<thiessenPolygon>
				<inputVariable>
					<variableId>station_precip</variableId>
				</inputVariable>
				<distanceGeoDatum>$DISTANCEGEODATUM$</distanceGeoDatum>
				<outputVariable>
					<variableId>basin_precip</variableId>
				</outputVariable>
			</thiessenPolygon>
		</interpolationSpatial>
	</transformation>
	<transformation id="station_temperature_to_daily">
		<statisticsSerial>
			<mean>
				<inputVariable>
					<variableId>station_temp_hourly</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>station_temp_ave</variableId>
				</outputVariable>
			</mean>
		</statisticsSerial>
	</transformation>
	<transformation id="station_temperature_to_daily_max">
		<statisticsSerial>
			<max>
				<inputVariable>
					<variableId>station_temp_hourly</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>station_temp_max</variableId>
				</outputVariable>
			</max>
		</statisticsSerial>
	</transformation>
	<transformation id="station_temperature_to_daily_min">
		<statisticsSerial>
			<max>
				<inputVariable>
					<variableId>station_temp_hourly</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>station_temp_min</variableId>
				</outputVariable>
			</max>
		</statisticsSerial>
	</transformation>
	<transformation id="basin_temp_ave">
		<interpolationSpatial>
			<thiessenPolygon>
				<inputVariable>
					<variableId>station_temp_ave</variableId>
				</inputVariable>
				<distanceGeoDatum>$DISTANCEGEODATUM$</distanceGeoDatum>
				<outputVariable>
					<variableId>basin_temp_ave</variableId>
				</outputVariable>
			</thiessenPolygon>
		</interpolationSpatial>
	</transformation>
	<transformation id="basin_temp_max">
		<interpolationSpatial>
			<thiessenPolygon>
				<inputVariable>
					<variableId>station_temp_max</variableId>
				</inputVariable>
				<distanceGeoDatum>$DISTANCEGEODATUM$</distanceGeoDatum>
				<outputVariable>
					<variableId>basin_temp_max</variableId>
				</outputVariable>
			</thiessenPolygon>
		</interpolationSpatial>
	</transformation>
	<transformation id="basin_temp_min">
		<interpolationSpatial>
			<thiessenPolygon>
				<inputVariable>
					<variableId>station_temp_min</variableId>
				</inputVariable>
				<distanceGeoDatum>$DISTANCEGEODATUM$</distanceGeoDatum>
				<outputVariable>
					<variableId>basin_temp_min</variableId>
				</outputVariable>
			</thiessenPolygon>
		</interpolationSpatial>
	</transformation>
</transformationModule>