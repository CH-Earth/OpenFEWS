	<!--Transformations - precip-->
	<transformation id="fill_gridded_precip">
		<merge>
			<simple>
				<inputVariable>
					<variableId>gridded_precip_rate_unfilled</variableId>
				</inputVariable>
				<fillGapConstant>0.0</fillGapConstant>
				<outputVariable>
					<variableId>gridded_precip_rate_filled</variableId>
				</outputVariable>
			</simple>
		</merge>
	</transformation>
	<transformation id="precip_grid_to_basin">
		<interpolationSpatial>
			<average>
				<inputVariable>
					<variableId>gridded_precip_rate_filled</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>basin_precip_rate</variableId>
				</outputVariable>
			</average>
		</interpolationSpatial>
	</transformation>
	<transformation id="basin_precip_rate_to_accum">
		<user>
			<simple>
				<expression>basin_precip_rate * 3600 * $TIMESTEP$</expression>
				<outputVariable>
					<variableId>basin_precip</variableId>
				</outputVariable>
			</simple>
		</user>
	</transformation>
	<transformation id="basin_precip_daily">
		<aggregation>
			<accumulative>
				<inputVariable>
					<variableId>basin_precip</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>basin_precip_daily</variableId>
				</outputVariable>
			</accumulative>
		</aggregation>
	</transformation>
	<transformation id="precip_grid_to_subbasin">
		<interpolationSpatial>
			<average>
				<inputVariable>
					<variableId>gridded_precip_rate_filled</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>subbasin_precip_rate</variableId>
				</outputVariable>
			</average>
		</interpolationSpatial>
	</transformation>
	<transformation id="basin_precip_rate_to_accum">
		<user>
			<simple>
				<expression>subbasin_precip_rate * 3600 * $TIMESTEP$</expression>
				<outputVariable>
					<variableId>subbasin_precip</variableId>
				</outputVariable>
			</simple>
		</user>
	</transformation>
	<transformation id="subbasin_precip_daily">
		<aggregation>
			<accumulative>
				<inputVariable>
					<variableId>subbasin_precip</variableId>
				</inputVariable>
				<outputVariable>
					<variableId>subbasin_precip_daily</variableId>
				</outputVariable>
			</accumulative>
		</aggregation>
	</transformation>
	<transformation id="station_precip_rate">
		<interpolationSpatial>
			<closestDistance>
				<inputVariable>
					<variableId>gridded_precip_rate_filled</variableId>
				</inputVariable>
				<distanceGeoDatum>$DISTANCEGEODATUM$</distanceGeoDatum>
				<outputVariable>
					<variableId>station_precip_rate</variableId>
				</outputVariable>
			</closestDistance>
		</interpolationSpatial>
	</transformation>
	<transformation id="station_precip_rate_to_accum">
		<user>
