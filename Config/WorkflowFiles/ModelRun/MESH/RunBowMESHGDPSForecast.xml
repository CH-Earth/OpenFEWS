<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
	<!-- Run MESH Model Forecast -->
	<properties>
		<string key="STARTTIME" value="-30"/>
		<string key="ENDTIME" value="0"/>
		<string key="FORECAST_TIMESTEP" value="3"/>
		<string key="MODELBASINS" value="BowMESHBasins"/>
		<string key="BAT_FILE" value="run_mesh.bat"/>
		<string key="MODEL" value="Bow"/>
		<string key="INPUT_GRID_MODULE" value="PreprocessGDPS"/>	
		<string key="MODELGRID" value="ModelGrid"/>
		<string key="ENSEMBLE" value="main"/>
		<int key="TIMESHIFT" value="8"/>

	</properties>
	<!-- Run Forecast Model to Create Updated State-->
	<activity>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>BowMESHForecast</moduleInstanceId>
		<moduleConfigFileName>MESHForecastTemplate</moduleConfigFileName>
	</activity>
</workflow>
