<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
	<!-- Run Raven Model Historic -->
	<!-- General Properties -->
	<properties>
		<string key="MODEL" value="Elbow"/>
		<string key="STARTTIME" value="-25"/>
		<string key="ENDTIME" value="0"/>
	</properties>
	<!-- Gap fill input observations-->
		<activity>
		<properties>
			<string key="INPUT_MODULE_INSTANCE_ID" value="ImportMeteoStations"/>
			<string key="LOCATIONSET" value="ElbowMeteoStations"/>
			<string key="TIMESTEP" value="day_GMT"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ElbowRavenHistoric</moduleInstanceId>
		<moduleConfigFileName>FillMeteoStationDataTemplate</moduleConfigFileName>
	</activity>
	<!-- Run Raven Historic-->
	<activity>
		<properties>
		<string key="INPUTMODULEINSTANCEMETEO" value="ElbowRavenHistoric"/>
		<string key="INPUTLOCATIONSET" value="ElbowMeteoStations"/>
		<string key="OUTPUTTIMESERIES" value="ElbowRavenHistoric"/>
	</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ElbowRavenHistoric</moduleInstanceId>
		<moduleConfigFileName>RavenHistoricStateUpdateTemplate</moduleConfigFileName>
	</activity>
	
	<!-- Postprocess Model Results-->
	<activity>
		<properties>
			<string key="TIMESERIESTYPE" value="external historical"/>
			<string key="TIMESTEP" value="$DAY_TIMESTEP$"/>
			<string key="LOCATIONSET" value="ElbowSubBasins"/>
		</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ElbowRavenHistoric</moduleInstanceId>
		<moduleConfigFileName>PreprocessMeteoToDailyTemplate</moduleConfigFileName>
	</activity>
</workflow>
