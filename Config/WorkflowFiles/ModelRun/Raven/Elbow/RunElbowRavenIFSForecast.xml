<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
	<!-- Run Model Forecast -->
	<properties>
		<string key="FORECAST" value="IFS"/>
		<string key="STARTTIME" value="-5"/>
		<string key="FORECAST_ENDTIME" value="7"/>
		<string key="TIMESTEP" value="$DAY_TIMESTEP$"/>
		<string key="FORECASTMODULEINSTANCE" value="PreprocessIFS"/>
		<string key="MODEL" value="Elbow"/>
		<string key="ENSEMBLE" value="IFS"/>
		<string key="EXPORTDATASET" value="ElbowRavenForecast"/>
		<string key="FORECASTLOCATIONSET" value="ProcessBasins"/>
	</properties>
	<!--Set Forecast Length-->
	<activity>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>SetForecastLengthIFS</moduleInstanceId>
		<moduleConfigFileName>SetForecastLengthTemplate</moduleConfigFileName>
	</activity>
	<!--Set Merge Historic and Forecast Data-->
	<activity>
		<properties>
		<string key="LOCATIONSET" value="ElbowSubBasins"/>
	</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>PreprocessIFS</moduleInstanceId>
		<moduleConfigFileName>MergeRavenMeteoTemplate</moduleConfigFileName>
		<ensemble>
			<ensembleId>IFS</ensembleId>
			<runInLoop>true</runInLoop>
		</ensemble>
	</activity>
	<!--Run model in for IFS Forecast-->
	<activity>
	<properties>
		<string key="INPUTMODULEINSTANCEMETEO" value="PreprocessIFS"/>
	</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ElbowRavenIFSForecast</moduleInstanceId>
		<moduleConfigFileName>RavenForecastTemplate</moduleConfigFileName>
		<ensemble>
			<ensembleId>IFS</ensembleId>
			<runInLoop>true</runInLoop>
		</ensemble>
	</activity>
	<!--Calculate Statistics for IFS Forecast-->
	<activity>
	<properties>
		<string key="INPUTMODULEINSTANCE" value="ElbowRavenIFSForecast"/>
		<string key="TIMESERIESTYPE" value="simulated forecasting"/>
		<string key="PARAMETER" value="QR.sim"/>
		<string key="LOCATIONSET" value="ElbowHydroStations"/>
		<string key="TIMESTEP" value="1"/>
	</properties>
		<runIndependent>true</runIndependent>
		<moduleInstanceId>ElbowRavenIFSForecast</moduleInstanceId>
		<moduleConfigFileName>CalculateEnsembleStatisticsTemplate</moduleConfigFileName>
	</activity>
</workflow>