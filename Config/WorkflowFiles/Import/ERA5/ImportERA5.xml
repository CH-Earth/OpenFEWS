<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
	<!--Define Properties for Templates-->
	<properties>
		<string key="DATA_SOURCE" value="ECMWF"/>
		<!-- EnsembleID if needed-->
		<string key="ENSEMBLE" value="main"/>
		<!--Subbasin Location-->
		<string key="BASINLOCATIONS" value="ProcessBasins"/>
		<!--Basin Location-->
		<string key="SUBBASINLOCATIONS" value="ProcessSubBasins"/>
		<!--Station Locations-->
		<string key="STATIONLOCATIONS" value="ProcessMeteoStations"/>
		<!--Time Series Type-->
		<string key="GRIDTIMESERIESTYPE" value="external historical"/>
		<string key="BASINTIMESERIESTYPE" value="external historical"/>
		<string key="SUBBASINTIMESERIESTYPE" value="external historical"/>
		<string key="STATIONTIMESERIESTYPE" value="external historical"/>
		<!-- Unit Conversion -->
		<string key="UNITCONVERSION" value="ImportECCCNWPUnitConversions"/>
	</properties>
	<activity>
		<properties>
			<!-- Data Source Name-->
			<string key="MODEL" value="ERA5"/>
			<!-- Input Grid-->
			<string key="INPUTGRID" value="ERA5"/>
			<!-- Input Module Instance ID-->
			<string key="INPUTMODULEINSTANCE" value="ImportERA5"/>
			<!--Ensemble-->
			<string key="ENSEMBLE" value="main"/>
			<!--Timeseries Type-->
			<string key="TIMESTEP" value="1"/>
			<!--Parameter Type-->
			<string key="PARAMETER" value="PC.sim"/>
			<!--File Type-->
			<string key="IMPORTTYPE" value="grib2"/>
		</properties>
		<workflowId>ImportPrecipAnalysisTemplate</workflowId>
	</activity>
</workflow>