<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://www.wldelft.nl/fews" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.wldelft.nl/fews http://fews.wldelft.nl/schemas/version1.0/workflow.xsd" version="1.1">
	<!--Define Properties for Templates-->
	<properties>
		<!-- EnsembleID if needed-->
		<string key="ENSEMBLE" value="main"/>
		<!--Subbasin Location-->
		<string key="BASINLOCATIONS" value="HindcastBasins"/>
		<!--Basin Location-->
		<string key="SUBBASINLOCATIONS" value="HindcastSubBasins"/>
		<!--Station Locations-->
		<string key="STATIONLOCATIONS" value="HindcastMeteoStations"/>
		<!--Time Series Type-->
		<string key="GRID_TIMESERIESTYPE" value="external forecasting"/>
		<string key="PROCESSED_TIMESERIESTYPE" value="external forecasting"/>
		<string key="SUBBASIN_TIMESERIESTYPE" value="external forecasting"/>
		<!-- Unit Conversion -->
		<string key="UNITCONVERSION" value="ImportECCCNWPUnitConversions"/>
	</properties>
	<activity>
		<properties>
			<!-- Data Source Name-->
			<string key="DATA_SOURCE" value="ECCC_NWP"/>
			<!-- Data Source Name-->
			<string key="MODEL" value="RDPS"/>
			<!-- NWP Timestep-->
			<string key="TIMESTEP" value="1"/>
			<!-- Expiry Timestep-->
			<string key="EXPIRYTIME" value="7"/>
		</properties>
		<workflowId>ImportNWPTemplate</workflowId>
	</activity>
</workflow>

